# Content-Security-Policy of the frontend, filled in by docker/start.sh
# (production) and vue.config.js (dev server, report-only).
# The page may only talk to itself, the backend and the login server (OIDC).
# Lines starting with # are removed; the rest is joined into one line.
#
# 'unsafe-eval': @samply/lens compiles a JSON schema at runtime with
# new Function(...) (ajv). Can be removed once lens ships precompiled schemas.
default-src 'self';
script-src 'self' 'unsafe-eval';
style-src 'self' 'unsafe-inline';
img-src 'self' data: blob: ${BACKEND_ORIGIN};
font-src 'self' data:;
connect-src 'self' ${BACKEND_ORIGIN} ${OIDC_ORIGIN};
frame-src 'self' ${OIDC_ORIGIN};
frame-ancestors 'self';
form-action 'self' ${OIDC_ORIGIN};
base-uri 'self';
object-src 'none'
